datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x", "debian-openssl-3.0.x"]
}

model Admin {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model GatewayConfig {
  id              String   @id @default("default") @map("_id")
  upiId           String   @default("merchant@upi")
  imapEmail       String   @default("")
  imapAppPassword String   @default("")
  webhookUrl      String   @default("")
  updatedAt       DateTime @updatedAt
}

model ApiKey {
  id          String    @id @default(auto()) @map("_id") @db.ObjectId
  name        String
  key         String    @unique // e.g. og_live_abc123...
  status      String    @default("ACTIVE") // ACTIVE, REVOKED
  totalOrders Int       @default(0)
  lastUsed    DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Transaction {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @unique
  amount     Float
  status     String   @default("PENDING") // PENDING, SUCCESS, FAILED
  utr        String?
  apiKeyName String?
  createdAt  DateTime @default(now())
  expiresAt  DateTime
  updatedAt  DateTime @updatedAt
}

model NotificationLog {
  id             String   @id @default(auto()) @map("_id") @db.ObjectId
  packageName    String   @default("")
  title          String   @default("")
  text           String   @default("")
  amount         Float?
  utr            String?
  matchedOrderId String?
  status         String   @default("UNMATCHED") // MATCHED, UNMATCHED, IGNORED
  createdAt      DateTime @default(now())
}
